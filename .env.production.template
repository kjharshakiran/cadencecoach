# ═══════════════════════════════════════════════════════════════
# Spartan Coach - Production Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.production and fill in your values
# These should be set as Cloud Run environment variables or secrets

# Required: Claude API (via LiteLLM)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Required: Session encryption
SECRET_KEY=generate-a-long-random-string-here

# Required: Default login credentials
DEFAULT_USERNAME=your-username
DEFAULT_PASSWORD=your-secure-password

# Optional: Google OAuth (for Google login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: Google Calendar API (same as OAuth or separate)
# Uses the same credentials as Google OAuth

# Environment flag
ENVIRONMENT=production

# Port (Cloud Run sets this automatically)
# PORT=8080
