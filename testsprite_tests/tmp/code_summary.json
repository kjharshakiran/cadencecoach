{
  "project_name": "Spartan Coach",
  "description": "AI-powered fitness accountability application with multi-agent architecture using Google ADK and Claude/Gemini",
  "tech_stack": {
    "backend": {
      "framework": "FastAPI",
      "language": "Python 3.x",
      "runtime": "Uvicorn/Gunicorn",
      "ai_framework": "Google Agent Development Kit (ADK)",
      "llm_providers": ["Claude (Anthropic)", "Gemini (Google)"],
      "database": "SQLite (SQLAlchemy)",
      "scheduler": "APScheduler",
      "auth": ["OAuth (Google)", "Session-based (username/password)"]
    },
    "frontend": {
      "framework": "Vanilla JavaScript",
      "ui": "HTML5/CSS3",
      "charts": "Chart.js"
    },
    "integrations": {
      "calendar": "Google Calendar API",
      "fitness_tracker": "Whoop API",
      "messaging": "WhatsApp (custom service)",
      "cloud": "Google Cloud Platform"
    },
    "key_dependencies": [
      "google-adk[database]==0.3.0",
      "litellm==1.66.3",
      "fastapi",
      "uvicorn[standard]",
      "sqlalchemy",
      "apscheduler",
      "httpx",
      "pydantic"
    ]
  },
  "architecture": {
    "pattern": "Multi-Agent Hierarchical System (The Phalanx)",
    "agents": [
      {
        "name": "THE_SPARTAN",
        "role": "Root orchestrator/commander",
        "file": "spartan_phalanx/main.py",
        "description": "Routes user requests to specialized sub-agents"
      },
      {
        "name": "planner_agent",
        "role": "Strategist/coordinator",
        "file": "spartan_phalanx/sub_agents/planner_agent.py",
        "description": "Creates Master Plan with BMR/TDEE calculations, coordinates nutrition and fitness agents"
      },
      {
        "name": "fitness_agent",
        "role": "Workout planning",
        "file": "spartan_phalanx/sub_agents/fitness_agent.py",
        "description": "Generates 7-day workout plans based on split and equipment"
      },
      {
        "name": "nutrition_agent",
        "role": "Diet planning",
        "file": "spartan_phalanx/sub_agents/nutrition_agent.py",
        "description": "Creates diet principles and daily meal plans"
      },
      {
        "name": "monitoring_agent",
        "role": "Progress tracking/scout",
        "file": "spartan_phalanx/sub_agents/monitoring_agent.py",
        "description": "Analyzes logs and fitness tracker data, outputs JSON metrics"
      }
    ]
  },
  "key_features": [
    "User onboarding with profile creation (age, height, weight, goals)",
    "BMR/TDEE calculation using Mifflin-St Jeor equation",
    "Personalized fitness plan generation (7-day workout splits)",
    "Customized nutrition plans with meal suggestions",
    "Progress tracking via daily logs",
    "Whoop fitness tracker integration (screenshot analysis)",
    "Scheduled automated check-ins (9AM, 12PM, 3PM, 9PM)",
    "Google Calendar integration for workout scheduling",
    "WhatsApp two-way chat integration",
    "Multi-user support with session management",
    "OAuth and session-based authentication",
    "Plan locking/confirmation workflow",
    "Timezone-aware notifications"
  ],
  "api_endpoints": [
    {
      "path": "/api/chat",
      "method": "POST",
      "description": "Main chat endpoint for user-agent interaction"
    },
    {
      "path": "/api/onboard",
      "method": "POST",
      "description": "User onboarding with profile data"
    },
    {
      "path": "/api/reset",
      "method": "POST",
      "description": "Reset user session and plan"
    },
    {
      "path": "/api/state",
      "method": "GET",
      "description": "Get current session state"
    },
    {
      "path": "/auth/login",
      "method": "POST",
      "description": "Username/password authentication"
    },
    {
      "path": "/auth/google",
      "method": "GET",
      "description": "Google OAuth login initiation"
    },
    {
      "path": "/auth/whoop",
      "method": "GET",
      "description": "Whoop OAuth integration"
    },
    {
      "path": "/whatsapp/webhook",
      "method": "POST",
      "description": "WhatsApp message webhook"
    }
  ],
  "database_schema": {
    "session_state_fields": [
      "warrior_profile",
      "master_plan",
      "daily_logs",
      "plan_locked"
    ]
  },
  "environment_variables": [
    "ANTHROPIC_API_KEY",
    "GOOGLE_API_KEY",
    "MODEL_PROVIDER",
    "CLAUDE_MODEL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "WHOOP_CLIENT_ID",
    "WHOOP_CLIENT_SECRET",
    "SESSION_SECRET"
  ],
  "deployment": {
    "local_port": 8000,
    "production_server": "gunicorn",
    "cloud_platform": "Google Cloud Platform",
    "database": "Cloud SQL (PostgreSQL) or SQLite"
  }
}
